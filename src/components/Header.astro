---
import { site } from '../site';
---

<header class="sticky top-0 z-20 border-b-2 border-gold/70 bg-maroon-deep/95 text-gold-light backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-extrabold tracking-tight">
      <img src="/favicon.svg" alt="" class="size-8" />
      {site.name}
    </a>
    <span lang="km" class="hidden text-sm text-gold-light/80 sm:inline">រក្សាទុកវីដេអូរបស់អ្នក</span>
  </div>
</header>
