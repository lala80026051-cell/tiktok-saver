---
// The Start here page (/start): how to get the app and run it on your own Windows computer.
// It has its own web address, so it can be shared, and the top bar links to it from every page.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StartHere from '../components/StartHere.astro';
---

<Base title="Start here" description="How to get TikTok Saver and run it on your own Windows computer.">
  <Header />

  <main>
    <section class="khmer-hero relative overflow-hidden text-center text-ivory">
      <div class="relative mx-auto max-w-3xl px-4 pt-10 pb-28 sm:px-6 sm:pt-14">
        <svg class="float mx-auto h-20 w-16 drop-shadow-[0_8px_18px_rgba(224,169,59,0.45)] sm:h-24 sm:w-20" viewBox="0 0 120 150" aria-hidden="true">
          <use href="#k-flame"></use>
        </svg>
        <h1 class="mt-4">
          <span lang="km" class="font-moul gold-text block text-3xl sm:text-5xl">ចាប់ផ្តើមនៅទីនេះ</span>
          <span class="mt-2 block font-display text-2xl font-extrabold tracking-tight text-gold-light sm:text-3xl">Start here</span>
        </h1>
        <svg class="mx-auto mt-5 h-5 w-72 text-gold" viewBox="0 0 320 24" aria-hidden="true"><use href="#k-divider"></use></svg>
      </div>
      <div class="gold-strip absolute inset-x-0 bottom-0"></div>
    </section>

    <!-- The two empty sides of the card get a Khmer pattern, and (on wide screens) an ornament column. -->
    <div class="khmer-sides khmer-pillars">
      <!-- Only the left column: the free space on the right holds the how-to video. -->
      <div class="khmer-pillar khmer-pillar-left" aria-hidden="true"></div>
      <section class="relative mx-auto -mt-16 max-w-3xl px-4 pb-16 sm:px-6">
        <StartHere />
      </section>
    </div>
  </main>

  <Footer />
</Base>
