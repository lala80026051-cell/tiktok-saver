---
// The homepage in a Khmer look: gold ornament on deep red, and an ivory card with a gold frame.
// The ornaments are drawn here as small original SVG shapes, not copied from anywhere.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StartHere from '../components/StartHere.astro';

// The three steps shown under the headline.
const steps = [
  { en: 'Paste the link', km: 'បិទភ្ជាប់តំណ' },
  { en: 'Choose your options', km: 'ជ្រើសរើសជម្រើស' },
  { en: 'Download', km: 'ទាញយក' },
];

// The four feature cards at the bottom of the page.
const perks = [
  {
    icon: '🎞️',
    en: 'Best quality',
    km: 'គុណភាពល្អបំផុត',
    text: 'You get the biggest size that TikTok has for each video.',
    textKm: 'អ្នកទទួលបានទំហំធំបំផុតដែល TikTok មានសម្រាប់វីដេអូនីមួយៗ។',
  },
  {
    icon: '💬',
    en: 'Caption on the video',
    km: 'caption លើវីដេអូ',
    text: 'Every video gets its own caption, written at the bottom.',
    textKm: 'វីដេអូនីមួយៗមាន caption ផ្ទាល់ខ្លួន សរសេរនៅខាងក្រោម។',
  },
  {
    icon: '🔢',
    en: 'Numbered files',
    km: 'ឯកសារមានលេខ',
    text: 'Files are named 001, 002, 003… so they stay in order.',
    textKm: 'ឯកសារមានឈ្មោះ 001, 002, 003… ដើម្បីឱ្យនៅតាមលំដាប់។',
  },
  {
    icon: '⏹️',
    en: 'Stop any time',
    km: 'បញ្ឈប់បានគ្រប់ពេល',
    text: 'Videos that are already finished stay saved.',
    textKm: 'វីដេអូដែលបានចប់រួចហើយនៅតែត្រូវបានរក្សាទុក។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- TOP BAND -->
    <section class="khmer-hero relative overflow-hidden text-ivory">
      <div class="relative mx-auto max-w-4xl px-4 pt-12 pb-28 text-center sm:px-6 sm:pt-16">
        <svg class="float mx-auto h-28 w-24 drop-shadow-[0_8px_18px_rgba(224,169,59,0.45)] sm:h-36 sm:w-28" viewBox="0 0 120 150" aria-hidden="true">
          <use href="#k-flame"></use>
        </svg>

        <h1 class="mt-5">
          <span lang="km" class="font-moul gold-text block text-3xl sm:text-5xl lg:text-6xl">រក្សាទុកវីដេអូរបស់អ្នក</span>
          <span class="mt-3 block font-display text-2xl font-extrabold tracking-tight text-gold-light sm:text-4xl">Save your videos in seconds.</span>
        </h1>

        <svg class="mx-auto mt-6 h-5 w-72 text-gold" viewBox="0 0 320 24" aria-hidden="true"><use href="#k-divider"></use></svg>

        <p class="mx-auto mt-6 max-w-xl text-lg text-ivory/85">
          Choose TikTok, YouTube, Facebook or Instagram. Paste a link, choose the quality, and your video is saved with its own caption and a number.
          <span class="km" lang="km">ជ្រើសរើស TikTok, YouTube, Facebook ឬ Instagram។ បិទភ្ជាប់តំណ ជ្រើសរើសគុណភាព ហើយវីដេអូរបស់អ្នកត្រូវបានរក្សាទុកជាមួយ caption និងលេខផ្ទាល់ខ្លួន។</span>
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <span class="chip">🎵 TikTok</span>
          <span class="chip">▶️ YouTube</span>
          <span class="chip">📘 Facebook</span>
          <span class="chip">📸 Instagram</span>
          <span class="chip">🔒 Private</span>
          <span class="chip">💻 Runs on your computer</span>
          <span class="chip">🇰🇭 English + ខ្មែរ</span>
        </div>

        <ol class="mx-auto mt-8 grid max-w-2xl gap-3 text-left sm:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="flex items-center gap-3 rounded-2xl border border-gold/50 bg-maroon-deep/55 p-3">
                <span class="step-chip !size-10 text-sm">{i + 1}</span>
                <span class="text-sm leading-snug text-gold-light">
                  {s.en}
                  <span class="km text-xs" lang="km">{s.km}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="gold-strip absolute inset-x-0 bottom-0"></div>
    </section>

    <!-- The empty sides of the cards get a Khmer pattern. The ornament columns are switched on only on
         the public page (where there is no side panel), by the script at the bottom. -->
    <div id="sides" class="khmer-sides">
    <div class="khmer-pillar khmer-pillar-left" aria-hidden="true"></div>

    <!-- THE CARD -->
    <section class="relative mx-auto -mt-16 max-w-3xl px-4 pb-14 sm:px-6 xl:grid xl:max-w-none xl:grid-cols-[1fr_48rem_1fr] xl:items-start xl:gap-8">
      <!-- LEFT SIDE PANEL: the four site buttons. It shows only on wide screens (there is room on the left). -->
      <aside class="card-khmer hidden p-6 xl:sticky xl:top-24 xl:block xl:w-64 xl:justify-self-end" aria-label="Choose the site">
        <svg class="corner corner-tl" aria-hidden="true"><use href="#k-corner"></use></svg>
        <svg class="corner corner-tr" aria-hidden="true"><use href="#k-corner"></use></svg>
        <p class="relative mt-2 font-display text-lg font-extrabold text-brand-dark">
          Choose the site
          <span class="km font-moul text-sm" lang="km">ជ្រើសរើសវេទិកា</span>
        </p>
        <svg class="mx-auto mt-3 h-4 w-40 text-gold" viewBox="0 0 320 24" aria-hidden="true"><use href="#k-divider"></use></svg>
        <div class="mt-4 flex flex-col gap-3" role="group" aria-label="Site">
          <button type="button" data-platform="tiktok" class="platform-button flex w-full items-center gap-3 rounded-2xl border-2 px-4 py-3 text-left text-lg font-semibold transition">
            <span class="text-2xl" aria-hidden="true">🎵</span>
            <span>TikTok <span class="km text-sm" lang="km">ធីកតុក</span></span>
          </button>
          <button type="button" data-platform="youtube" class="platform-button flex w-full items-center gap-3 rounded-2xl border-2 px-4 py-3 text-left text-lg font-semibold transition">
            <span class="text-2xl" aria-hidden="true">▶️</span>
            <span>YouTube <span class="km text-sm" lang="km">យូធូប</span></span>
          </button>
          <button type="button" data-platform="facebook" class="platform-button flex w-full items-center gap-3 rounded-2xl border-2 px-4 py-3 text-left text-lg font-semibold transition">
            <span class="text-2xl" aria-hidden="true">📘</span>
            <span>Facebook <span class="km text-sm" lang="km">ហ្វេសប៊ុក</span></span>
          </button>
          <button type="button" data-platform="instagram" class="platform-button flex w-full items-center gap-3 rounded-2xl border-2 px-4 py-3 text-left text-lg font-semibold transition">
            <span class="text-2xl" aria-hidden="true">📸</span>
            <span>Instagram <span class="km text-sm" lang="km">អ៊ីនស្តាក្រាម</span></span>
          </button>
        </div>
        <p class="mt-4 text-sm text-muted">
          Then paste the link in the card →
          <span class="km" lang="km">បន្ទាប់មកបិទភ្ជាប់តំណក្នុងកាត →</span>
        </p>
      </aside>

      <div class="min-w-0">
      <StartHere id="public-guide" class="hidden" />

      <p id="banner" role="status" class="mb-4 hidden rounded-2xl border-2 border-gold bg-ivory p-4 shadow-lg"></p>

      <!-- Shown on a phone or another computer: it asks for the code that is shown on the computer. -->
      <form id="pin-box" class="mb-4 hidden rounded-2xl border-2 border-gold bg-ivory p-5 shadow-lg">
        <label for="pin-input" class="font-display text-lg font-bold text-brand-dark">
          🔐 Enter the code shown on the computer
          <span class="km text-base" lang="km">បញ្ចូលលេខកូដដែលបង្ហាញលើកុំព្យូទ័រ</span>
        </label>
        <div class="mt-3 flex gap-3">
          <input
            id="pin-input"
            inputmode="numeric"
            autocomplete="off"
            maxlength="12"
            class="w-full rounded-xl border-2 border-gold/60 bg-white px-4 py-3 text-lg tracking-widest outline-none focus:border-brand"
          />
          <button type="submit" class="btn-main rounded-full px-7 py-2 font-bold">OK</button>
        </div>
        <p id="pin-error" class="mt-2 hidden text-sm font-semibold text-brand"></p>
      </form>

      <form id="save-form" class="card-khmer p-7 sm:p-10" novalidate>
        <svg class="corner corner-tl" aria-hidden="true"><use href="#k-corner"></use></svg>
        <svg class="corner corner-tr" aria-hidden="true"><use href="#k-corner"></use></svg>
        <svg class="corner corner-bl" aria-hidden="true"><use href="#k-corner"></use></svg>
        <svg class="corner corner-br" aria-hidden="true"><use href="#k-corner"></use></svg>

        <!-- STEP 1 -->
        <div class="flex items-center gap-3">
          <span class="step-chip">1</span>
          <label for="link" class="font-display text-xl font-bold text-brand-dark">
            Choose the site, then paste the link
            <span class="km text-base" lang="km">ជ្រើសរើសវេទិកា ហើយបិទភ្ជាប់តំណ</span>
          </label>
        </div>

        <!-- The site the video is from. The page checks the link against this choice. -->
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4 xl:hidden" role="group" aria-label="Site">
          <button type="button" data-platform="tiktok" class="platform-button rounded-2xl border-2 px-3 py-3 text-center font-semibold transition">
            🎵 TikTok
          </button>
          <button type="button" data-platform="youtube" class="platform-button rounded-2xl border-2 px-3 py-3 text-center font-semibold transition">
            ▶️ YouTube
          </button>
          <button type="button" data-platform="facebook" class="platform-button rounded-2xl border-2 px-3 py-3 text-center font-semibold transition">
            📘 Facebook
          </button>
          <button type="button" data-platform="instagram" class="platform-button rounded-2xl border-2 px-3 py-3 text-center font-semibold transition">
            📸 Instagram
          </button>
        </div>
        <p id="platform-note" class="mt-2 text-sm text-muted"></p>

        <input
          id="link"
          name="link"
          type="url"
          inputmode="url"
          autocomplete="off"
          placeholder="https://www.tiktok.com/..."
          class="mt-3 w-full rounded-2xl border-2 border-gold/60 bg-white px-5 py-4 text-base outline-none transition focus:border-brand focus:shadow-[0_0_0_4px_rgb(224_169_59/0.3)]"
        />

        <svg class="mx-auto mt-8 h-4 w-56 text-gold" viewBox="0 0 320 24" aria-hidden="true"><use href="#k-divider"></use></svg>

        <!-- STEP 2 -->
        <div class="mt-6 flex items-center gap-3">
          <span class="step-chip">2</span>
          <p class="font-display text-xl font-bold text-brand-dark">
            Choose your options
            <span class="km text-base" lang="km">ជ្រើសរើសជម្រើសរបស់អ្នក</span>
          </p>
        </div>

        <p id="remote-note" class="mt-4 hidden rounded-2xl border border-gold/50 bg-paper/60 p-4 text-sm text-muted">
          📱 You are using another device. Videos are saved on the computer, and when a download is finished you get links to save them on this device.
          <span class="km" lang="km">អ្នកកំពុងប្រើឧបករណ៍ផ្សេង។ វីដេអូត្រូវបានរក្សាទុកលើកុំព្យូទ័រ ហើយពេលការទាញយកចប់ អ្នកទទួលបានតំណដើម្បីរក្សាទុកវាលើឧបករណ៍នេះ។</span>
        </p>

        <div id="folder-box" class="mt-4 rounded-2xl border border-gold/50 bg-paper/60 p-4 sm:p-5">
          <p class="font-display text-base font-bold">
            📁 Save to
            <span class="km text-sm" lang="km">រក្សាទុកទៅ</span>
          </p>
          <!-- The folder name has its own full-width row. The two buttons sit in a row below it. -->
          <p id="folder-path" class="mt-2 w-full rounded-xl border border-gold/50 bg-white px-4 py-3 text-sm break-words">…</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <button
              id="choose-folder"
              type="button"
              class="btn-alt rounded-full px-5 py-2 font-semibold disabled:cursor-not-allowed disabled:opacity-50"
            >
              Choose folder <span lang="km" class="font-khmer font-normal opacity-70">ជ្រើសរើសថត</span>
            </button>
            <button
              id="open-folder"
              type="button"
              class="rounded-full border-2 border-gold bg-maroon px-5 py-2 font-semibold text-gold-light transition hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-50"
            >
              📂 Open folder <span lang="km" class="font-khmer font-normal opacity-80">បើកថតមើលវីដេអូ</span>
            </button>
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-gold/50 bg-paper/60 p-4 sm:p-5">
          <label for="quality" class="block font-display text-base font-bold">
            🎞️ Quality
            <span class="km text-sm" lang="km">គុណភាព</span>
          </label>
          <select
            id="quality"
            class="mt-2 w-full rounded-xl border border-gold/60 bg-white px-4 py-3 text-base outline-none focus:border-brand"
          >
            <option value="best">Best available (recommended)</option>
            <option value="2160">4K (2160p) - TikTok has no 4K, you get its best</option>
            <option value="1440">1440p</option>
            <option value="1080">1080p</option>
            <option value="720">720p</option>
            <option value="480">480p</option>
            <option value="360">360p</option>
            <option value="240">240p</option>
            <option value="144">144p</option>
          </select>
          <p class="mt-2 text-sm text-muted">
            TikTok decides which qualities a video has. Most videos are 1080p or lower, and TikTok has no 4K. If the quality you choose is not there, you get the closest one. After the download, the page tells you the quality you really got.
            <span class="km" lang="km">TikTok កំណត់ថាវីដេអូមានគុណភាពអ្វីខ្លះ។ វីដេអូភាគច្រើនមាន 1080p ឬទាបជាងនេះ ហើយ TikTok គ្មាន 4K ទេ។ បើគុណភាពដែលអ្នកជ្រើសមិនមាន អ្នកនឹងទទួលបានគុណភាពជិតបំផុត។ បន្ទាប់ពីការទាញយក ទំព័រប្រាប់អ្នកពីគុណភាពដែលអ្នកទទួលបានពិតប្រាកដ។</span>
          </p>
        </div>

        <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-2xl border border-gold/50 bg-paper/60 p-4 sm:p-5">
          <input id="caption" type="checkbox" checked class="mt-1 size-5 shrink-0 accent-brand" />
          <span>
            <span class="font-display text-base font-bold">💬 Put the caption on the video</span>
            <span class="km font-display text-sm font-bold" lang="km">ដាក់ caption លើវីដេអូ</span>
            <span class="mt-1 block text-sm text-muted">
              The caption is written at the bottom of the picture. This takes extra time, and the picture is processed again.
              <span class="km" lang="km">caption ត្រូវបានសរសេរនៅខាងក្រោមរូបភាព។ វាចំណាយពេលបន្ថែម ហើយរូបភាពត្រូវបានដំណើរការម្តងទៀត។</span>
            </span>
          </span>
        </label>

        <svg class="mx-auto mt-8 h-4 w-56 text-gold" viewBox="0 0 320 24" aria-hidden="true"><use href="#k-divider"></use></svg>

        <!-- STEP 3 -->
        <div class="mt-6 flex items-center gap-3">
          <span class="step-chip">3</span>
          <p class="font-display text-xl font-bold text-brand-dark">
            Download
            <span class="km text-base" lang="km">ទាញយក</span>
          </p>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            data-mode="one"
            class="mode-button btn-main flex-1 rounded-full px-6 py-4 text-lg font-bold"
          >
            ⬇️ Download 1 video <span lang="km" class="font-khmer text-base font-normal opacity-90">ទាញយក ១ វីដេអូ</span>
          </button>
          <button
            type="button"
            data-mode="all"
            class="mode-button btn-alt flex-1 rounded-full px-6 py-4 text-lg font-bold disabled:cursor-not-allowed disabled:opacity-50"
          >
            📚 Download all videos <span lang="km" class="font-khmer text-base font-normal opacity-75">ទាញយកវីដេអូទាំងអស់</span>
          </button>
        </div>
        <button
          id="stop"
          type="button"
          disabled
          class="mt-3 w-full rounded-full border-2 border-navy bg-navy px-6 py-3 font-semibold text-gold-light shadow-lg shadow-navy/25 transition hover:bg-brand-dark hover:border-brand-dark disabled:cursor-not-allowed disabled:border-ink/10 disabled:bg-ink/10 disabled:text-ink/40 disabled:shadow-none"
        >
          ⏹ Stop download <span lang="km" class="font-khmer font-normal opacity-80">បញ្ឈប់ការទាញយក</span>
        </button>

        <ul class="mt-5 space-y-2 text-sm text-muted">
          <li>
            <b class="text-ink">1 video:</b> copy the link of the video.
            <span class="km" lang="km">១ វីដេអូ៖ ចម្លងតំណរបស់វីដេអូ។</span>
          </li>
          <li>
            <b class="text-ink">All videos:</b> copy the link of the profile (account) or of a video.
            <span class="km" lang="km">វីដេអូទាំងអស់៖ ចម្លងតំណរបស់ប្រូហ្វាល់ (គណនី) ឬតំណរបស់វីដេអូ។</span>
          </li>
        </ul>
        <p id="message" role="status" class="msg msg-info mt-5 hidden"></p>
        <div id="device-files" class="mt-3 hidden space-y-2"></div>
      </form>

      <p class="mt-6 rounded-2xl border border-gold/50 bg-gold/15 px-4 py-3 text-sm text-ink/85">
        🙏 Only save your own videos, or videos where the owner says OK. This also applies to "all videos" of a profile.
        <span class="km" lang="km">រក្សាទុកតែវីដេអូរបស់អ្នកផ្ទាល់ ឬវីដេអូដែលម្ចាស់អនុញ្ញាត។ នេះក៏ត្រូវប្រើជាមួយ "វីដេអូទាំងអស់" របស់ប្រូហ្វាល់ដែរ។</span>
      </p>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
      <svg class="mx-auto h-5 w-72 text-gold" viewBox="0 0 320 24" aria-hidden="true"><use href="#k-divider"></use></svg>
      <h2 class="mt-5 text-center font-display text-3xl font-extrabold tracking-tight text-brand-dark sm:text-4xl">
        Made to be simple
        <span class="km font-moul" lang="km">បង្កើតឡើងដើម្បីឱ្យសាមញ្ញ</span>
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          perks.map((p) => (
            <article class="lift rounded-3xl border-2 border-gold/60 bg-ivory p-6">
              <span class="step-chip !size-14 text-2xl" aria-hidden="true">{p.icon}</span>
              <h3 class="mt-4 font-display text-lg font-bold text-brand-dark">
                {p.en}
                <span class="km" lang="km">{p.km}</span>
              </h3>
              <p class="mt-2 text-sm text-muted">
                {p.text}
                <span class="km" lang="km">{p.textKm}</span>
              </p>
            </article>
          ))
        }
      </div>
    </section>
    </div>
  </main>

  <Footer />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#save-form')!;
  const input = document.querySelector<HTMLInputElement>('#link')!;
  const message = document.querySelector<HTMLElement>('#message')!;

  function show(en: string, km: string) {
    // The box color follows the kind of message: done (green), problem (red), or working (orange).
    const kind = en.startsWith('✅')
      ? 'msg-success'
      : /^(Could not|The helper|Lost contact|That is not|This is a|TikTok did not|You are on)/.test(en)
        ? 'msg-error'
        : /^(Stopped|A window opened)/.test(en)
          ? 'msg-info'
          : 'msg-working';
    message.className = `msg ${kind} mt-5`;
    message.innerHTML = '';
    message.append(en);
    const span = document.createElement('span');
    span.className = 'km';
    span.lang = 'km';
    span.textContent = km;
    message.append(span);
    message.classList.remove('hidden');
  }

  // The four sites. Each has its own example link and its own note for "all videos".
  type Site = 'tiktok' | 'youtube' | 'facebook' | 'instagram';
  const sites: Record<Site, { name: string; domains: string[]; placeholder: string; note: string; noteKm: string }> = {
    tiktok: {
      name: 'TikTok',
      domains: ['tiktok.com'],
      placeholder: 'https://www.tiktok.com/@name/video/...',
      note: 'All videos: paste the link of the profile, or of one video of the account.',
      noteKm: 'វីដេអូទាំងអស់៖ បិទភ្ជាប់តំណរបស់ប្រូហ្វាល់ ឬតំណរបស់វីដេអូមួយនៃគណនី។',
    },
    youtube: {
      name: 'YouTube',
      domains: ['youtube.com', 'youtu.be', 'youtube-nocookie.com'],
      placeholder: 'https://www.youtube.com/watch?v=...',
      note: 'All videos: paste the link of a channel or of a playlist. Big sizes can take longer.',
      noteKm: 'វីដេអូទាំងអស់៖ បិទភ្ជាប់តំណរបស់ឆានែល ឬបញ្ជីចាក់។ ទំហំធំអាចចំណាយពេលយូរជាង។',
    },
    facebook: {
      name: 'Facebook',
      domains: ['facebook.com', 'fb.watch', 'fb.com'],
      placeholder: 'https://www.facebook.com/.../videos/...',
      note: 'Only public videos work. A video that asks you to log in cannot be saved.',
      noteKm: 'មានតែវីដេអូសាធារណៈទេដែលដំណើរការ។ វីដេអូដែលសុំឱ្យចូលគណនីមិនអាចរក្សាទុកបានទេ។',
    },
    instagram: {
      name: 'Instagram',
      domains: ['instagram.com'],
      placeholder: 'https://www.instagram.com/reel/...',
      note: 'Only public posts work. Instagram often asks you to log in, and then it cannot be saved.',
      noteKm: 'មានតែប្រកាសសាធារណៈទេដែលដំណើរការ។ Instagram ច្រើនតែសុំឱ្យចូលគណនី ហើយពេលនោះមិនអាចរក្សាទុកបានទេ។',
    },
  };

  // Which site a link belongs to, or null.
  function siteOf(text: string): Site | null {
    try {
      const host = new URL(text.trim()).hostname.toLowerCase();
      for (const [key, site] of Object.entries(sites)) {
        if (site.domains.some((d) => host === d || host.endsWith(`.${d}`))) return key as Site;
      }
    } catch {
      // Not a link at all.
    }
    return null;
  }

  // The site button that is chosen. The choice is remembered.
  const siteButtons = [...document.querySelectorAll<HTMLButtonElement>('.platform-button')];
  const siteNote = document.querySelector<HTMLElement>('#platform-note')!;
  let site: Site = 'tiktok';
  try {
    const saved = localStorage.getItem('site');
    if (saved && saved in sites) site = saved as Site;
  } catch {
    site = 'tiktok';
  }

  function setSite(next: Site) {
    site = next;
    try {
      localStorage.setItem('site', next);
    } catch {
      // The browser will not remember it. That is fine.
    }
    for (const button of siteButtons) {
      const on = button.dataset.platform === next;
      button.setAttribute('aria-pressed', String(on));
      for (const name of ['border-gold', 'bg-maroon', 'text-gold-light', 'shadow-lg']) button.classList.toggle(name, on);
      for (const name of ['border-gold/40', 'bg-white', 'text-ink']) button.classList.toggle(name, !on);
    }
    input.placeholder = sites[next].placeholder;
    siteNote.textContent = `${sites[next].note} `;
    const km = document.createElement('span');
    km.className = 'km';
    km.lang = 'km';
    km.textContent = sites[next].noteKm;
    siteNote.append(km);
  }
  for (const button of siteButtons) button.addEventListener('click', () => setSite((button.dataset.platform as Site) ?? 'tiktok'));
  setSite(site);

  // Works out what kind of link this is for the chosen site: a 'video', a 'profile', or null.
  function linkKind(text: string, which: Site): 'video' | 'profile' | null {
    let url: URL;
    try {
      url = new URL(text.trim());
    } catch {
      return null;
    }
    const host = url.hostname.toLowerCase();
    const path = url.pathname.replace(/\/+$/, '');

    if (which === 'tiktok') {
      if (/^\/@[^/]+$/.test(path)) return 'profile';
      // Video pages, and the short share links (vm.tiktok.com, vt.tiktok.com, tiktok.com/t/...).
      if (/^\/@[^/]+\/(video|photo)\/\d+/.test(path)) return 'video';
      if (host.startsWith('vm.') || host.startsWith('vt.') || path.startsWith('/t/')) return 'video';
      return null;
    }

    if (which === 'youtube') {
      if (host === 'youtu.be' && path.length > 1) return 'video';
      if (path === '/watch' && url.searchParams.has('v')) return 'video';
      if (/^\/(shorts|live|embed)\/[^/]+/.test(path)) return 'video';
      if (path === '/playlist' || /^\/(@[^/]+|channel\/[^/]+|c\/[^/]+|user\/[^/]+)/.test(path)) return 'profile';
      return null;
    }

    if (which === 'facebook') {
      if (host === 'fb.watch') return path.length > 1 ? 'video' : null;
      if (/\/(videos|reel|reels|watch|share\/(v|r))(\/|$)/.test(path) || url.searchParams.has('v')) return 'video';
      return path.length > 1 ? 'profile' : null;
    }

    // Instagram
    if (/^\/(p|reel|reels|tv)\/[^/]+/.test(path)) return 'video';
    if (/^\/[^/]+$/.test(path)) return 'profile';
    return null;
  }

  function choose(mode: string) {
    const found = siteOf(input.value);
    if (!found) {
      show(
        'That is not a link from TikTok, YouTube, Facebook or Instagram. Please copy the link and try again.',
        'នេះមិនមែនជាតំណពី TikTok, YouTube, Facebook ឬ Instagram ទេ។ សូមចម្លងតំណ ហើយព្យាយាមម្តងទៀត។',
      );
      return;
    }
    if (found !== site) {
      // The link is from another site than the chosen one: switch the button, and ask to press again.
      setSite(found);
      show(
        `This is a ${sites[found].name} link, so I chose ${sites[found].name} for you. Press the button again.`,
        `នេះជាតំណ ${sites[found].name} ដូច្នេះខ្ញុំបានជ្រើស ${sites[found].name} ឱ្យអ្នក។ សូមចុចប៊ូតុងម្តងទៀត។`,
      );
      return;
    }
    const kind = linkKind(input.value, site);
    if (!kind) {
      show(
        `That does not look like a ${sites[site].name} video or account link. Please copy the link again from ${sites[site].name}.`,
        `នេះមើលទៅមិនដូចតំណវីដេអូ ឬគណនី ${sites[site].name} ទេ។ សូមចម្លងតំណម្តងទៀតពី ${sites[site].name}។`,
      );
      return;
    }
    if (mode === 'one' && kind === 'profile') {
      show(
        'This is a profile link. To download 1 video, copy the link of that video. To download every video, use the other button.',
        'នេះជាតំណប្រូហ្វាល់។ ដើម្បីទាញយក ១ វីដេអូ សូមចម្លងតំណរបស់វីដេអូនោះ។ ដើម្បីទាញយកទាំងអស់ សូមប្រើប៊ូតុងមួយទៀត។',
      );
      return;
    }
    save(mode);
  }

  // Sends the link to the helper program on this computer, then checks on it until it is done.
  const HELPER = '/helper';
  let busy = false;
  let currentJob = '';

  // On a phone or another computer, the code from the computer is sent with every request.
  let pin = '';
  try {
    pin = sessionStorage.getItem('saverPin') ?? '';
  } catch {
    pin = '';
  }
  // True when this page is opened from another device (the helper tells us).
  let remoteMode = false;

  function helperFetch(url: string, init: RequestInit = {}) {
    const headers = new Headers(init.headers);
    if (pin) headers.set('X-Saver-Pin', pin);
    return fetch(url, { ...init, headers });
  }

  // On another device, a finished download shows one link per video, to save it on that device.
  const deviceFiles = document.querySelector<HTMLElement>('#device-files')!;
  function showDeviceFiles(jobId: string, files: { index: number; name: string }[]) {
    deviceFiles.replaceChildren();
    if (!remoteMode || files.length === 0) {
      deviceFiles.classList.add('hidden');
      return;
    }
    for (const file of files.slice(0, 50)) {
      const link = document.createElement('a');
      link.href = `${HELPER}/file/${jobId}/${file.index}`;
      link.download = file.name;
      link.className = 'btn-main block rounded-2xl px-4 py-3 text-center font-semibold break-words';
      link.textContent = `⬇️ Save to this device: ${file.name}`;
      deviceFiles.append(link);
    }
    if (files.length > 50) {
      const more = document.createElement('p');
      more.className = 'text-sm text-muted';
      more.textContent = `…and ${files.length - 50} more videos on the computer.`;
      deviceFiles.append(more);
    }
    deviceFiles.classList.remove('hidden');
  }
  const stopButton = document.querySelector<HTMLButtonElement>('#stop')!;

  // The Stop button: asks the helper to stop. The page then shows "Stopped" by itself.
  stopButton.addEventListener('click', () => {
    if (!currentJob) return;
    stopButton.disabled = true;
    helperFetch(`${HELPER}/stop`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
      body: JSON.stringify({ id: currentJob }),
    }).catch(() => {
      stopButton.disabled = false;
    });
  });

  async function save(mode: string) {
    if (busy) return;
    busy = true;
    deviceFiles.classList.add('hidden');
    show('Working… please wait. Big profiles can take a long time.', 'កំពុងដំណើរការ… សូមរង់ចាំ។ ប្រូហ្វាល់ធំអាចចំណាយពេលយូរ។');
    try {
      let start: Response;
      try {
        start = await helperFetch(`${HELPER}/download`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
          body: JSON.stringify({ link: input.value.trim(), mode, quality: document.querySelector<HTMLSelectElement>('#quality')!.value, folder, caption: document.querySelector<HTMLInputElement>('#caption')!.checked }),
        });
      } catch {
        // The browser could not reach the helper at all.
        show(
          'The helper program is not running. Open a terminal in your project and run: npm run helper',
          'កម្មវិធីជំនួយមិនដំណើរការទេ។ បើក terminal ក្នុងគម្រោងរបស់អ្នក ហើយរត់៖ npm run helper',
        );
        return;
      }
      if (start.status === 404 || start.status === 405) {
        // Only the copy of the site running on your own computer has the helper.
        show(
          'You are on the public website. Downloading only works on your own computer. Double-click start.bat in your tiktok-saver folder.',
          'អ្នកកំពុងនៅលើគេហទំព័រសាធារណៈ។ ការទាញយកដំណើរការតែលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ប៉ុណ្ណោះ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក។',
        );
        return;
      }
      if (!start.ok) {
        show(`The helper did not accept this request (code ${start.status}). Please copy the link again from TikTok.`, `កម្មវិធីជំនួយមិនទទួលសំណើនេះទេ (លេខកូដ ${start.status})។ សូមចម្លងតំណម្តងទៀតពី TikTok។`);
        return;
      }
      const { id } = await start.json();
      currentJob = id;
      stopButton.disabled = false;
      while (true) {
        await new Promise((resolve) => setTimeout(resolve, 1500));
        const info = await (await helperFetch(`${HELPER}/status/${id}`)).json();
        if (info.status === 'running' && info.stage === 'finding') {
          show('Finding the account of this video…', 'កំពុងរកគណនីរបស់វីដេអូនេះ…');
        } else if (info.status === 'running' && info.stage === 'captioning') {
          show(`Writing the caption on the video… ${info.captioned} of ${info.count}`, `កំពុងសរសេរ caption លើវីដេអូ… ${info.captioned} ក្នុងចំណោម ${info.count}`);
        } else if (info.status === 'running') {
          show(`Saved ${info.count} video(s) so far…`, `បានរក្សាទុក ${info.count} វីដេអូរហូតមកដល់ឥឡូវ…`);
        } else if (info.status === 'done') {
          const quality = info.heights?.length ? ` (${info.heights.map((h: string) => `${h}p`).join(', ')})` : '';
          // The folder is only told to the computer itself, not to other devices.
          const where = info.folder ? ` in: ${info.folder}` : '';
          const whereKm = info.folder ? ` ក្នុងថត៖ ${info.folder}` : '';
          show(`✅ Finish download. Saved ${info.count} video(s)${quality}${where}`, `✅ ការទាញយកបានបញ្ចប់។ បានរក្សាទុក ${info.count} វីដេអូ${quality}${whereKm}`);
          if (info.notes?.length) message.append(` ⚠ ${info.notes.join(' ')}`);
          showDeviceFiles(id, info.files ?? []);
          break;
        } else if (info.status === 'stopped') {
          show(
            `Stopped. ${info.count} video(s) were already saved and are still in your folder.`,
            `បានបញ្ឈប់។ មាន ${info.count} វីដេអូត្រូវបានរក្សាទុករួចហើយ ហើយនៅក្នុងថតរបស់អ្នកនៅឡើយ។`,
          );
          break;
        } else {
          show(`Could not save the video. ${info.message}`, 'មិនអាចរក្សាទុកវីដេអូបានទេ។ TikTok អាចរារាំង ឬវីដេអូជាឯកជន។');
          break;
        }
      }
    } catch {
      show('Lost contact with the helper while saving. Check that it is still running, then try again.', 'បាត់ទំនាក់ទំនងជាមួយកម្មវិធីជំនួយពេលកំពុងរក្សាទុក។ សូមពិនិត្យថាវានៅដំណើរការ ហើយព្យាយាមម្តងទៀត។');
    } finally {
      busy = false;
      currentJob = '';
      stopButton.disabled = true;
    }
  }

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.mode-button')];
  const banner = document.querySelector<HTMLElement>('#banner')!;
  const openFolder = document.querySelector<HTMLButtonElement>('#open-folder')!;

  for (const button of buttons) {
    button.addEventListener('click', () => choose(button.dataset.mode ?? 'one'));
  }

  // The folder where videos are saved. The choice is remembered in this browser.
  const folderPath = document.querySelector<HTMLElement>('#folder-path')!;
  const chooseButton = document.querySelector<HTMLButtonElement>('#choose-folder')!;
  let folder = '';
  try {
    folder = localStorage.getItem('saveFolder') ?? '';
  } catch {
    folder = '';
  }
  if (folder) folderPath.textContent = folder;

  function setFolder(path: string) {
    folder = path;
    folderPath.textContent = path;
    try {
      localStorage.setItem('saveFolder', path);
    } catch {
      // The browser will not remember it. That is fine.
    }
  }

  openFolder.addEventListener('click', () => {
    helperFetch(`${HELPER}/open-folder`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
      body: JSON.stringify({ folder }),
    }).catch(() => {});
  });

  chooseButton.addEventListener('click', async () => {
    chooseButton.disabled = true;
    show('A window opened to choose a folder. It may be behind this page. Look at your taskbar.', 'បង្អួចមួយបានបើកដើម្បីជ្រើសរើសថត។ វាអាចនៅពីក្រោយទំព័រនេះ។ សូមមើលរបារកិច្ចការរបស់អ្នក។');
    try {
      const reply = await helperFetch(`${HELPER}/choose-folder`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
        body: JSON.stringify({ folder }),
      });
      const picked = (await reply.json()).folder;
      if (picked) setFolder(picked);
      message.classList.add('hidden');
    } catch {
      show('Could not open the folder window. Check that the helper is running.', 'មិនអាចបើកបង្អួចថតបានទេ។ សូមពិនិត្យថាកម្មវិធីជំនួយកំពុងដំណើរការ។');
    } finally {
      chooseButton.disabled = false;
    }
  });

  // Checks that the helper is ready. If not, say what to do and switch the buttons off.
  const pinBox = document.querySelector<HTMLFormElement>('#pin-box')!;
  const pinInput = document.querySelector<HTMLInputElement>('#pin-input')!;
  const pinError = document.querySelector<HTMLElement>('#pin-error')!;

  async function checkHelper() {
    let ready = false;
    // 'ok', 'pin' (a code is needed), 'closed' (the computer is not shared), 'locked', or 'down'.
    let state = 'down';
    try {
      const reply = await helperFetch(`${HELPER}/ping`);
      const info = await reply.json();
      ready = reply.ok && info.ok === true;
      state = ready ? 'ok' : info.pin ? 'pin' : info.closed ? 'closed' : info.locked ? 'locked' : 'down';
      if (ready) remoteMode = info.remote === true;
      // First time: show the helper's own default folder (only on the computer itself).
      if (ready && !remoteMode && !folder) setFolder(info.folder);
    } catch {
      ready = false;
    }
    // On another device there are no folder choices. A note explains how to save the video there.
    document.querySelector('#folder-box')!.classList.toggle('hidden', remoteMode);
    document.querySelector('#remote-note')!.classList.toggle('hidden', !remoteMode);
    pinBox.classList.toggle('hidden', state !== 'pin');
    for (const button of buttons) {
      button.disabled = !ready;
      button.classList.toggle('opacity-50', !ready);
      button.classList.toggle('cursor-not-allowed', !ready);
    }
    chooseButton.disabled = !ready;
    openFolder.disabled = !ready;
    if (ready || state === 'pin') {
      banner.classList.add('hidden');
      return;
    }
    // What to tell the person, in English and in Khmer.
    let en: string;
    let km: string;
    if (state === 'closed') {
      en = 'This computer is not shared with other devices. On the computer, double-click start-network.bat.';
      km = 'កុំព្យូទ័រនេះមិនត្រូវបានចែករំលែកជាមួយឧបករណ៍ផ្សេងទេ។ នៅលើកុំព្យូទ័រ សូមចុចពីរដងលើ start-network.bat។';
    } else if (state === 'locked') {
      en = 'Too many wrong codes. Please try again in 10 minutes.';
      km = 'លេខកូដខុសច្រើនពេក។ សូមព្យាយាមម្តងទៀតក្នុងរយៈពេល 10 នាទី។';
    } else if (!onThisComputer) {
      en = 'Cannot reach the computer. Check that the computer is on, that start-network.bat is running, and that this device uses the same Wi-Fi.';
      km = 'មិនអាចភ្ជាប់ទៅកុំព្យូទ័របានទេ។ សូមពិនិត្យថាកុំព្យូទ័របើក start-network.bat កំពុងដំណើរការ ហើយឧបករណ៍នេះប្រើ Wi-Fi តែមួយ។';
    } else {
      en = 'The helper is not running. Double-click start.bat in your tiktok-saver folder.';
      km = 'កម្មវិធីជំនួយមិនដំណើរការទេ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក។';
    }
    banner.textContent = en;
    const kmSpan = document.createElement('span');
    kmSpan.className = 'km';
    kmSpan.lang = 'km';
    kmSpan.textContent = km;
    banner.append(kmSpan);
    banner.classList.remove('hidden');
  }

  // The code box: the code is shown on the computer. It is kept only until this tab is closed.
  pinBox.addEventListener('submit', async (event) => {
    event.preventDefault();
    pin = pinInput.value.trim();
    try {
      sessionStorage.setItem('saverPin', pin);
    } catch {
      // The browser will not remember it. That is fine.
    }
    await checkHelper();
    const wrong = !pinBox.classList.contains('hidden');
    pinError.textContent = wrong ? 'Wrong code. Please try again. · លេខកូដខុស។ សូមព្យាយាមម្តងទៀត។' : '';
    pinError.classList.toggle('hidden', !wrong);
  });

  // Is this page opened on this computer, or on another device (or on the public website)?
  const onThisComputer = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
  // The public website has no helper behind it: it answers with a page, not with data.
  let hasHelper = onThisComputer;
  async function startUp() {
    if (!onThisComputer) {
      try {
        const reply = await helperFetch(`${HELPER}/ping`);
        await reply.json();
        hasHelper = true;
      } catch {
        hasHelper = false;
      }
    }
    if (hasHelper) {
      checkHelper();
      setInterval(() => {
        if (!busy) checkHelper();
      }, 4000);
    } else {
      // The public website: no download box, just the "Start here" steps. The site buttons on the
      // left have nothing to do here, so they go away and the guide is centered.
      document.querySelector('#public-guide')!.classList.remove('hidden');
      form.classList.add('hidden');
      document.querySelector('aside')?.remove();
      document.querySelector('#sides')?.classList.add('khmer-pillars');
      form.closest('section')?.classList.remove('xl:grid', 'xl:max-w-none');
    }
  }
  startUp();
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    choose('one');
  });
</script>
