---
// The homepage: a box where you paste a TikTok link.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />

  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 -right-40 size-[30rem] rounded-full bg-sun/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-40 size-[26rem] rounded-full bg-brand/15 blur-3xl"></div>

    <section class="relative mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
      <h1 class="font-display text-4xl leading-tight font-extrabold tracking-tight text-balance sm:text-6xl">
        Save your <span class="text-brand">TikTok</span> video.
      </h1>
      <p lang="km" class="mt-3 text-xl text-ink/70">រក្សាទុកវីដេអូ TikTok របស់អ្នក</p>

      <form id="save-form" class="mt-10 rounded-2xl border border-ink/10 bg-white p-5 shadow-xl shadow-ink/5 sm:p-8" novalidate>
        <label for="link" class="font-display text-lg font-bold">
          Paste the TikTok link here
          <span class="km text-base" lang="km">បិទភ្ជាប់តំណ TikTok នៅទីនេះ</span>
        </label>
        <input
          id="link"
          name="link"
          type="url"
          inputmode="url"
          autocomplete="off"
          placeholder="https://www.tiktok.com/..."
          class="mt-3 w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 text-base outline-none focus:border-brand"
        />
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            data-mode="one"
            class="mode-button rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark"
          >
            Download 1 video <span lang="km" class="font-khmer font-normal opacity-80">ទាញយក ១ វីដេអូ</span>
          </button>
          <button
            type="button"
            data-mode="all"
            class="mode-button rounded-full border border-ink/20 bg-white px-6 py-3 font-semibold transition hover:border-ink/50"
          >
            Download all videos <span lang="km" class="font-khmer font-normal opacity-70">ទាញយកវីដេអូទាំងអស់</span>
          </button>
        </div>
        <ul class="mt-4 space-y-2 text-sm text-muted">
          <li>
            <b>1 video:</b> copy the link of the video.
            <span class="km" lang="km">១ វីដេអូ៖ ចម្លងតំណរបស់វីដេអូ។</span>
          </li>
          <li>
            <b>All videos:</b> copy the link of the profile (account) or of a video.
            <span class="km" lang="km">វីដេអូទាំងអស់៖ ចម្លងតំណរបស់ប្រូហ្វាល់ (គណនី) ឬតំណរបស់វីដេអូ។</span>
          </li>
        </ul>
        <p id="message" role="status" class="mt-4 hidden rounded-xl bg-paper p-4"></p>
      </form>

      <p class="mt-6 text-sm text-muted">
        Only save your own videos, or videos where the owner says OK. This also applies to "all videos" of a profile.
        <span class="km" lang="km">រក្សាទុកតែវីដេអូរបស់អ្នកផ្ទាល់ ឬវីដេអូដែលម្ចាស់អនុញ្ញាត។ នេះក៏ត្រូវប្រើជាមួយ "វីដេអូទាំងអស់" របស់ប្រូហ្វាល់ដែរ។</span>
      </p>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#save-form')!;
  const input = document.querySelector<HTMLInputElement>('#link')!;
  const message = document.querySelector<HTMLElement>('#message')!;

  function show(en: string, km: string) {
    message.innerHTML = '';
    message.append(en);
    const span = document.createElement('span');
    span.className = 'km';
    span.lang = 'km';
    span.textContent = km;
    message.append(span);
    message.classList.remove('hidden');
  }

  // Works out what kind of TikTok link this is: a 'video', a 'profile', or null.
  function linkKind(text: string): 'video' | 'profile' | null {
    let url: URL;
    try {
      url = new URL(text.trim());
    } catch {
      return null;
    }
    const host = url.hostname;
    if (host !== 'tiktok.com' && !host.endsWith('.tiktok.com')) return null;
    const path = url.pathname.replace(/\/+$/, '');
    if (/^\/@[^/]+$/.test(path)) return 'profile';
    // Video pages, and the short share links (vm.tiktok.com, vt.tiktok.com, tiktok.com/t/...).
    if (/^\/@[^/]+\/(video|photo)\/\d+/.test(path)) return 'video';
    if (host.startsWith('vm.') || host.startsWith('vt.') || path.startsWith('/t/')) return 'video';
    return null;
  }

  function choose(mode: string) {
    const kind = linkKind(input.value);
    if (!kind) {
      show('That is not a TikTok link. Please copy the link from TikTok and try again.', 'នេះមិនមែនជាតំណ TikTok ទេ។ សូមចម្លងតំណពី TikTok ហើយព្យាយាមម្តងទៀត។');
      return;
    }
    if (mode === 'one' && kind === 'profile') {
      show(
        'This is a profile link. To download 1 video, copy the link of that video. To download every video, use the other button.',
        'នេះជាតំណប្រូហ្វាល់។ ដើម្បីទាញយក ១ វីដេអូ សូមចម្លងតំណរបស់វីដេអូនោះ។ ដើម្បីទាញយកទាំងអស់ សូមប្រើប៊ូតុងមួយទៀត។',
      );
      return;
    }
    save(mode);
  }

  // Sends the link to the helper program on this computer, then checks on it until it is done.
  const HELPER = 'http://127.0.0.1:4330';
  let busy = false;

  async function save(mode: string) {
    if (busy) return;
    busy = true;
    show('Working… please wait. Big profiles can take a long time.', 'កំពុងដំណើរការ… សូមរង់ចាំ។ ប្រូហ្វាល់ធំអាចចំណាយពេលយូរ។');
    try {
      let start: Response;
      try {
        start = await fetch(`${HELPER}/download`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ link: input.value.trim(), mode }),
        });
      } catch {
        // The browser could not reach the helper at all.
        show(
          'The helper program is not running. Open a terminal in your project and run: npm run helper',
          'កម្មវិធីជំនួយមិនដំណើរការទេ។ បើក terminal ក្នុងគម្រោងរបស់អ្នក ហើយរត់៖ npm run helper',
        );
        return;
      }
      if (!start.ok) {
        show('The helper did not accept this link. Please copy the link again from TikTok.', 'កម្មវិធីជំនួយមិនទទួលតំណនេះទេ។ សូមចម្លងតំណម្តងទៀតពី TikTok។');
        return;
      }
      const { id } = await start.json();
      while (true) {
        await new Promise((resolve) => setTimeout(resolve, 1500));
        const info = await (await fetch(`${HELPER}/status/${id}`)).json();
        if (info.status === 'running') {
          show(`Saved ${info.count} video(s) so far…`, `បានរក្សាទុក ${info.count} វីដេអូរហូតមកដល់ឥឡូវ…`);
        } else if (info.status === 'done') {
          show(`Done! Saved ${info.count} video(s) in: ${info.folder}`, `រួចរាល់! បានរក្សាទុក ${info.count} វីដេអូក្នុងថត៖ ${info.folder}`);
          break;
        } else {
          show(`Could not save the video. ${info.message}`, 'មិនអាចរក្សាទុកវីដេអូបានទេ។ TikTok អាចរារាំង ឬវីដេអូជាឯកជន។');
          break;
        }
      }
    } catch {
      show('Lost contact with the helper while saving. Check that it is still running, then try again.', 'បាត់ទំនាក់ទំនងជាមួយកម្មវិធីជំនួយពេលកំពុងរក្សាទុក។ សូមពិនិត្យថាវានៅដំណើរការ ហើយព្យាយាមម្តងទៀត។');
    } finally {
      busy = false;
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.mode-button')) {
    button.addEventListener('click', () => choose(button.dataset.mode ?? 'one'));
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    choose('one');
  });
</script>
