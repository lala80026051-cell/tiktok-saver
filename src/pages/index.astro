---
// The homepage: a box where you paste a TikTok link.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />

  <main class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 -right-40 size-[30rem] rounded-full bg-sun/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-40 size-[26rem] rounded-full bg-brand/15 blur-3xl"></div>

    <section class="relative mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
      <h1 class="font-display text-4xl leading-tight font-extrabold tracking-tight text-balance sm:text-6xl">
        Save your <span class="text-brand">TikTok</span> video.
      </h1>
      <p lang="km" class="mt-3 text-xl text-ink/70">រក្សាទុកវីដេអូ TikTok របស់អ្នក</p>

      <!-- Shown only on the public website, where downloading cannot work. -->
      <section id="public-guide" class="mt-10 hidden rounded-2xl border border-ink/10 bg-white p-5 shadow-xl shadow-ink/5 sm:p-8">
        <h2 class="font-display text-2xl font-extrabold">
          Start here
          <span class="km text-lg" lang="km">ចាប់ផ្តើមនៅទីនេះ</span>
        </h2>
        <p class="mt-3 text-muted">
          Downloading works on your own computer, not on this public page.
          <span class="km" lang="km">ការទាញយកដំណើរការលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ មិនមែនលើទំព័រសាធារណៈនេះទេ។</span>
        </p>
        <ol class="mt-6 space-y-4">
          <li class="flex gap-4">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand font-display font-bold text-paper">1</span>
            <p class="pt-1">
              Open the <b>tiktok-saver</b> folder on your computer, and double-click <b>start.bat</b>.
              <span class="km text-muted" lang="km">បើកថត tiktok-saver លើកុំព្យូទ័ររបស់អ្នក ហើយចុចពីរដងលើ start.bat។</span>
            </p>
          </li>
          <li class="flex gap-4">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand font-display font-bold text-paper">2</span>
            <p class="pt-1">
              Your browser opens your own page. Paste the link there.
              <span class="km text-muted" lang="km">browser របស់អ្នកបើកទំព័រផ្ទាល់ខ្លួនរបស់អ្នក។ បិទភ្ជាប់តំណនៅទីនោះ។</span>
            </p>
          </li>
          <li class="flex gap-4">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand font-display font-bold text-paper">3</span>
            <p class="pt-1">
              Press <b>Download 1 video</b>. The video is saved in <b>Downloads\TikTok Saver</b>.
              <span class="km text-muted" lang="km">ចុច Download 1 video។ វីដេអូត្រូវបានរក្សាទុកក្នុង Downloads\TikTok Saver។</span>
            </p>
          </li>
        </ol>
        <a
          href="http://localhost:4323/"
          class="mt-6 inline-block rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark"
        >
          Open my page <span lang="km" class="font-khmer font-normal opacity-80">បើកទំព័ររបស់ខ្ញុំ</span>
        </a>
        <p class="mt-3 text-sm text-muted">
          This button works only after you double-click start.bat.
          <span class="km" lang="km">ប៊ូតុងនេះដំណើរការតែបន្ទាប់ពីអ្នកចុចពីរដងលើ start.bat ប៉ុណ្ណោះ។</span>
        </p>
      </section>

      <p id="banner" role="status" class="mt-8 hidden rounded-xl border border-brand/30 bg-brand/10 p-4"></p>

      <form id="save-form" class="mt-6 rounded-2xl border border-ink/10 bg-white p-5 shadow-xl shadow-ink/5 sm:p-8" novalidate>
        <label for="link" class="font-display text-lg font-bold">
          Paste the TikTok link here
          <span class="km text-base" lang="km">បិទភ្ជាប់តំណ TikTok នៅទីនេះ</span>
        </label>
        <input
          id="link"
          name="link"
          type="url"
          inputmode="url"
          autocomplete="off"
          placeholder="https://www.tiktok.com/..."
          class="mt-3 w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 text-base outline-none focus:border-brand"
        />
        <p class="mt-5 font-display text-lg font-bold">
          Save to
          <span class="km text-base" lang="km">រក្សាទុកទៅ</span>
        </p>
        <!-- The folder name has its own full-width row. The two buttons sit in a row below it. -->
        <p id="folder-path" class="mt-2 w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 text-sm break-words">…</p>
        <div class="mt-3 flex flex-wrap gap-3">
          <button
            id="choose-folder"
            type="button"
            class="rounded-full border border-ink/20 bg-white px-5 py-2 font-semibold transition hover:border-ink/50 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Choose folder <span lang="km" class="font-khmer font-normal opacity-70">ជ្រើសរើសថត</span>
          </button>
          <button
            id="open-folder"
            type="button"
            class="rounded-full bg-ink px-5 py-2 font-semibold text-paper transition hover:bg-brand disabled:cursor-not-allowed disabled:opacity-50"
          >
            📂 Open folder <span lang="km" class="font-khmer font-normal opacity-80">បើកថតមើលវីដេអូ</span>
          </button>
        </div>

        <label for="quality" class="mt-5 block font-display text-lg font-bold">
          Quality
          <span class="km text-base" lang="km">គុណភាព</span>
        </label>
        <select
          id="quality"
          class="mt-2 w-full rounded-xl border border-ink/20 bg-paper px-4 py-3 text-base outline-none focus:border-brand"
        >
          <option value="best">Best available (recommended)</option>
          <option value="2160">4K (2160p) - TikTok has no 4K, you get its best</option>
          <option value="1440">1440p</option>
          <option value="1080">1080p</option>
          <option value="720">720p</option>
          <option value="480">480p</option>
          <option value="360">360p</option>
          <option value="240">240p</option>
          <option value="144">144p</option>
        </select>
        <p class="mt-2 text-sm text-muted">
          TikTok decides which qualities a video has. Most videos are 1080p or lower, and TikTok has no 4K. If the quality you choose is not there, you get the closest one. After the download, the page tells you the quality you really got.
          <span class="km" lang="km">TikTok កំណត់ថាវីដេអូមានគុណភាពអ្វីខ្លះ។ វីដេអូភាគច្រើនមាន 1080p ឬទាបជាងនេះ ហើយ TikTok គ្មាន 4K ទេ។ បើគុណភាពដែលអ្នកជ្រើសមិនមាន អ្នកនឹងទទួលបានគុណភាពជិតបំផុត។ បន្ទាប់ពីការទាញយក ទំព័រប្រាប់អ្នកពីគុណភាពដែលអ្នកទទួលបានពិតប្រាកដ។</span>
        </p>
        <label class="mt-5 flex items-start gap-3">
          <input id="caption" type="checkbox" checked class="mt-1 size-5 accent-brand" />
          <span>
            <span class="font-display text-lg font-bold">Put the caption on the video</span>
            <span class="km font-display text-base font-bold" lang="km">ដាក់ caption លើវីដេអូ</span>
            <span class="mt-1 block text-sm text-muted">
              The caption is written at the bottom of the picture. This takes extra time, and the picture is processed again.
              <span class="km" lang="km">caption ត្រូវបានសរសេរនៅខាងក្រោមរូបភាព។ វាចំណាយពេលបន្ថែម ហើយរូបភាពត្រូវបានដំណើរការម្តងទៀត។</span>
            </span>
          </span>
        </label>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            data-mode="one"
            class="mode-button rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark"
          >
            Download 1 video <span lang="km" class="font-khmer font-normal opacity-80">ទាញយក ១ វីដេអូ</span>
          </button>
          <button
            type="button"
            data-mode="all"
            class="mode-button rounded-full border border-ink/20 bg-white px-6 py-3 font-semibold transition hover:border-ink/50"
          >
            Download all videos <span lang="km" class="font-khmer font-normal opacity-70">ទាញយកវីដេអូទាំងអស់</span>
          </button>
          <button
            id="stop"
            type="button"
            disabled
            class="rounded-full bg-red-600 px-6 py-3 font-semibold text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:bg-ink/20 disabled:text-ink/40"
          >
            ⏹ Stop download <span lang="km" class="font-khmer font-normal opacity-80">បញ្ឈប់ការទាញយក</span>
          </button>
        </div>
        <ul class="mt-4 space-y-2 text-sm text-muted">
          <li>
            <b>1 video:</b> copy the link of the video.
            <span class="km" lang="km">១ វីដេអូ៖ ចម្លងតំណរបស់វីដេអូ។</span>
          </li>
          <li>
            <b>All videos:</b> copy the link of the profile (account) or of a video.
            <span class="km" lang="km">វីដេអូទាំងអស់៖ ចម្លងតំណរបស់ប្រូហ្វាល់ (គណនី) ឬតំណរបស់វីដេអូ។</span>
          </li>
        </ul>
        <p id="message" role="status" class="mt-4 hidden rounded-xl bg-paper p-4"></p>
      </form>

      <p class="mt-6 text-sm text-muted">
        Only save your own videos, or videos where the owner says OK. This also applies to "all videos" of a profile.
        <span class="km" lang="km">រក្សាទុកតែវីដេអូរបស់អ្នកផ្ទាល់ ឬវីដេអូដែលម្ចាស់អនុញ្ញាត។ នេះក៏ត្រូវប្រើជាមួយ "វីដេអូទាំងអស់" របស់ប្រូហ្វាល់ដែរ។</span>
      </p>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#save-form')!;
  const input = document.querySelector<HTMLInputElement>('#link')!;
  const message = document.querySelector<HTMLElement>('#message')!;

  function show(en: string, km: string) {
    message.innerHTML = '';
    message.append(en);
    const span = document.createElement('span');
    span.className = 'km';
    span.lang = 'km';
    span.textContent = km;
    message.append(span);
    message.classList.remove('hidden');
  }

  // Works out what kind of TikTok link this is: a 'video', a 'profile', or null.
  function linkKind(text: string): 'video' | 'profile' | null {
    let url: URL;
    try {
      url = new URL(text.trim());
    } catch {
      return null;
    }
    const host = url.hostname;
    if (host !== 'tiktok.com' && !host.endsWith('.tiktok.com')) return null;
    const path = url.pathname.replace(/\/+$/, '');
    if (/^\/@[^/]+$/.test(path)) return 'profile';
    // Video pages, and the short share links (vm.tiktok.com, vt.tiktok.com, tiktok.com/t/...).
    if (/^\/@[^/]+\/(video|photo)\/\d+/.test(path)) return 'video';
    if (host.startsWith('vm.') || host.startsWith('vt.') || path.startsWith('/t/')) return 'video';
    return null;
  }

  function choose(mode: string) {
    const kind = linkKind(input.value);
    if (!kind) {
      show('That is not a TikTok link. Please copy the link from TikTok and try again.', 'នេះមិនមែនជាតំណ TikTok ទេ។ សូមចម្លងតំណពី TikTok ហើយព្យាយាមម្តងទៀត។');
      return;
    }
    if (mode === 'one' && kind === 'profile') {
      show(
        'This is a profile link. To download 1 video, copy the link of that video. To download every video, use the other button.',
        'នេះជាតំណប្រូហ្វាល់។ ដើម្បីទាញយក ១ វីដេអូ សូមចម្លងតំណរបស់វីដេអូនោះ។ ដើម្បីទាញយកទាំងអស់ សូមប្រើប៊ូតុងមួយទៀត។',
      );
      return;
    }
    save(mode);
  }

  // Sends the link to the helper program on this computer, then checks on it until it is done.
  const HELPER = '/helper';
  let busy = false;
  let currentJob = '';
  const stopButton = document.querySelector<HTMLButtonElement>('#stop')!;

  // The Stop button: asks the helper to stop. The page then shows "Stopped" by itself.
  stopButton.addEventListener('click', () => {
    if (!currentJob) return;
    stopButton.disabled = true;
    fetch(`${HELPER}/stop`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
      body: JSON.stringify({ id: currentJob }),
    }).catch(() => {
      stopButton.disabled = false;
    });
  });

  async function save(mode: string) {
    if (busy) return;
    busy = true;
    show('Working… please wait. Big profiles can take a long time.', 'កំពុងដំណើរការ… សូមរង់ចាំ។ ប្រូហ្វាល់ធំអាចចំណាយពេលយូរ។');
    try {
      let start: Response;
      try {
        start = await fetch(`${HELPER}/download`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
          body: JSON.stringify({ link: input.value.trim(), mode, quality: document.querySelector<HTMLSelectElement>('#quality')!.value, folder, caption: document.querySelector<HTMLInputElement>('#caption')!.checked }),
        });
      } catch {
        // The browser could not reach the helper at all.
        show(
          'The helper program is not running. Open a terminal in your project and run: npm run helper',
          'កម្មវិធីជំនួយមិនដំណើរការទេ។ បើក terminal ក្នុងគម្រោងរបស់អ្នក ហើយរត់៖ npm run helper',
        );
        return;
      }
      if (start.status === 404 || start.status === 405) {
        // Only the copy of the site running on your own computer has the helper.
        show(
          'You are on the public website. Downloading only works on your own computer. Double-click start.bat in your tiktok-saver folder.',
          'អ្នកកំពុងនៅលើគេហទំព័រសាធារណៈ។ ការទាញយកដំណើរការតែលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ប៉ុណ្ណោះ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក។',
        );
        return;
      }
      if (!start.ok) {
        show(`The helper did not accept this request (code ${start.status}). Please copy the link again from TikTok.`, `កម្មវិធីជំនួយមិនទទួលសំណើនេះទេ (លេខកូដ ${start.status})។ សូមចម្លងតំណម្តងទៀតពី TikTok។`);
        return;
      }
      const { id } = await start.json();
      currentJob = id;
      stopButton.disabled = false;
      while (true) {
        await new Promise((resolve) => setTimeout(resolve, 1500));
        const info = await (await fetch(`${HELPER}/status/${id}`)).json();
        if (info.status === 'running' && info.stage === 'captioning') {
          show(`Writing the caption on the video… ${info.captioned} of ${info.count}`, `កំពុងសរសេរ caption លើវីដេអូ… ${info.captioned} ក្នុងចំណោម ${info.count}`);
        } else if (info.status === 'running') {
          show(`Saved ${info.count} video(s) so far…`, `បានរក្សាទុក ${info.count} វីដេអូរហូតមកដល់ឥឡូវ…`);
        } else if (info.status === 'done') {
          const quality = info.heights?.length ? ` (${info.heights.map((h: string) => `${h}p`).join(', ')})` : '';
          show(`✅ Finish download. Saved ${info.count} video(s)${quality} in: ${info.folder}`, `✅ ការទាញយកបានបញ្ចប់។ បានរក្សាទុក ${info.count} វីដេអូ${quality} ក្នុងថត៖ ${info.folder}`);
          if (info.notes?.length) message.append(` ⚠ ${info.notes.join(' ')}`);
          break;
        } else if (info.status === 'stopped') {
          show(
            `Stopped. ${info.count} video(s) were already saved and are still in your folder.`,
            `បានបញ្ឈប់។ មាន ${info.count} វីដេអូត្រូវបានរក្សាទុករួចហើយ ហើយនៅក្នុងថតរបស់អ្នកនៅឡើយ។`,
          );
          break;
        } else {
          show(`Could not save the video. ${info.message}`, 'មិនអាចរក្សាទុកវីដេអូបានទេ។ TikTok អាចរារាំង ឬវីដេអូជាឯកជន។');
          break;
        }
      }
    } catch {
      show('Lost contact with the helper while saving. Check that it is still running, then try again.', 'បាត់ទំនាក់ទំនងជាមួយកម្មវិធីជំនួយពេលកំពុងរក្សាទុក។ សូមពិនិត្យថាវានៅដំណើរការ ហើយព្យាយាមម្តងទៀត។');
    } finally {
      busy = false;
      currentJob = '';
      stopButton.disabled = true;
    }
  }

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.mode-button')];
  const banner = document.querySelector<HTMLElement>('#banner')!;
  const openFolder = document.querySelector<HTMLButtonElement>('#open-folder')!;

  for (const button of buttons) {
    button.addEventListener('click', () => choose(button.dataset.mode ?? 'one'));
  }

  // The folder where videos are saved. The choice is remembered in this browser.
  const folderPath = document.querySelector<HTMLElement>('#folder-path')!;
  const chooseButton = document.querySelector<HTMLButtonElement>('#choose-folder')!;
  let folder = '';
  try {
    folder = localStorage.getItem('saveFolder') ?? '';
  } catch {
    folder = '';
  }
  if (folder) folderPath.textContent = folder;

  function setFolder(path: string) {
    folder = path;
    folderPath.textContent = path;
    try {
      localStorage.setItem('saveFolder', path);
    } catch {
      // The browser will not remember it. That is fine.
    }
  }

  openFolder.addEventListener('click', () => {
    fetch(`${HELPER}/open-folder`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
      body: JSON.stringify({ folder }),
    }).catch(() => {});
  });

  chooseButton.addEventListener('click', async () => {
    chooseButton.disabled = true;
    show('A window opened to choose a folder. It may be behind this page. Look at your taskbar.', 'បង្អួចមួយបានបើកដើម្បីជ្រើសរើសថត។ វាអាចនៅពីក្រោយទំព័រនេះ។ សូមមើលរបារកិច្ចការរបស់អ្នក។');
    try {
      const reply = await fetch(`${HELPER}/choose-folder`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
        body: JSON.stringify({ folder }),
      });
      const picked = (await reply.json()).folder;
      if (picked) setFolder(picked);
      message.classList.add('hidden');
    } catch {
      show('Could not open the folder window. Check that the helper is running.', 'មិនអាចបើកបង្អួចថតបានទេ។ សូមពិនិត្យថាកម្មវិធីជំនួយកំពុងដំណើរការ។');
    } finally {
      chooseButton.disabled = false;
    }
  });

  // Checks that the helper is ready. If not, say what to do and switch the buttons off.
  async function checkHelper() {
    let ready = false;
    try {
      const reply = await fetch(`${HELPER}/ping`);
      const info = await reply.json();
      ready = reply.ok && info.ok === true;
      // First time: show the helper's own default folder.
      if (ready && !folder) setFolder(info.folder);
    } catch {
      ready = false;
    }
    for (const button of buttons) {
      button.disabled = !ready;
      button.classList.toggle('opacity-50', !ready);
      button.classList.toggle('cursor-not-allowed', !ready);
    }
    chooseButton.disabled = !ready;
    openFolder.disabled = !ready;
    if (ready) {
      banner.classList.add('hidden');
      return;
    }
    banner.textContent = onThisComputer
      ? 'The helper is not running. Double-click start.bat in your tiktok-saver folder.'
      : 'This is the public website. Downloading only works on your own computer. Double-click start.bat in your tiktok-saver folder, then use the page that opens.';
    const km = document.createElement('span');
    km.className = 'km';
    km.lang = 'km';
    km.textContent = onThisComputer
      ? 'កម្មវិធីជំនួយមិនដំណើរការទេ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក។'
      : 'នេះជាគេហទំព័រសាធារណៈ។ ការទាញយកដំណើរការតែលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ប៉ុណ្ណោះ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក ហើយប្រើទំព័រដែលបើក។';
    banner.append(km);
    banner.classList.remove('hidden');
  }
  const onThisComputer = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
  if (onThisComputer) {
    checkHelper();
    setInterval(() => {
      if (!busy) checkHelper();
    }, 4000);
  } else {
    // The public website: no download box, just the "Start here" steps.
    document.querySelector('#public-guide')!.classList.remove('hidden');
    form.classList.add('hidden');
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    choose('one');
  });
</script>
