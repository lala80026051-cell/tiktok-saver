---
// The homepage: a colorful top band, and a card where you paste a TikTok link.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// The three steps shown under the headline.
const steps = [
  { icon: '🔗', en: 'Paste the link', km: 'បិទភ្ជាប់តំណ' },
  { icon: '🎛️', en: 'Choose your options', km: 'ជ្រើសរើសជម្រើស' },
  { icon: '⬇️', en: 'Download', km: 'ទាញយក' },
];

// The four feature cards at the bottom of the page.
const perks = [
  {
    icon: '🎞️',
    en: 'Best quality',
    km: 'គុណភាពល្អបំផុត',
    text: 'You get the biggest size that TikTok has for each video.',
    textKm: 'អ្នកទទួលបានទំហំធំបំផុតដែល TikTok មានសម្រាប់វីដេអូនីមួយៗ។',
  },
  {
    icon: '💬',
    en: 'Caption on the video',
    km: 'caption លើវីដេអូ',
    text: 'Every video gets its own caption, written at the bottom.',
    textKm: 'វីដេអូនីមួយៗមាន caption ផ្ទាល់ខ្លួន សរសេរនៅខាងក្រោម។',
  },
  {
    icon: '🔢',
    en: 'Numbered files',
    km: 'ឯកសារមានលេខ',
    text: 'Files are named 001, 002, 003… so they stay in order.',
    textKm: 'ឯកសារមានឈ្មោះ 001, 002, 003… ដើម្បីឱ្យនៅតាមលំដាប់។',
  },
  {
    icon: '⏹️',
    en: 'Stop any time',
    km: 'បញ្ឈប់បានគ្រប់ពេល',
    text: 'Videos that are already finished stay saved.',
    textKm: 'វីដេអូដែលបានចប់រួចហើយនៅតែត្រូវបានរក្សាទុក។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- TOP BAND -->
    <section class="hero relative overflow-hidden text-white">
      <div class="pointer-events-none absolute top-10 left-[8%] size-3 rounded-full bg-sun/80 float-slow" aria-hidden="true"></div>
      <div class="pointer-events-none absolute top-1/2 left-[46%] size-2 rounded-full bg-white/60 float" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-[10%] bottom-24 size-4 rounded-full bg-brand/80 float-slow" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-5xl items-center gap-10 px-4 pt-14 pb-32 sm:px-6 sm:pt-20 lg:grid-cols-[1.25fr_1fr]">
        <div>
          <div class="flex flex-wrap gap-2">
            <span class="chip">🔒 Private</span>
            <span class="chip">💻 Runs on your computer</span>
            <span class="chip">🇰🇭 English + ខ្មែរ</span>
          </div>

          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Save your <span class="gradient-text">TikTok</span> videos in seconds.
          </h1>
          <p lang="km" class="mt-4 text-xl text-white/80 sm:text-2xl">រក្សាទុកវីដេអូ TikTok របស់អ្នកក្នុងរយៈពេលតែប៉ុន្មានវិនាទី</p>
          <p class="mt-5 max-w-xl text-lg text-white/75">
            Paste a link, choose the quality, and your video is saved with its own caption and a number.
            <span class="km" lang="km">បិទភ្ជាប់តំណ ជ្រើសរើសគុណភាព ហើយវីដេអូរបស់អ្នកត្រូវបានរក្សាទុកជាមួយ caption និងលេខផ្ទាល់ខ្លួន។</span>
          </p>

          <ol class="mt-8 grid max-w-xl gap-3 sm:grid-cols-3">
            {
              steps.map((s, i) => (
                <li class="chip !items-start !rounded-2xl !p-3">
                  <span class="text-2xl" aria-hidden="true">{s.icon}</span>
                  <span class="text-sm leading-snug">
                    <b class="block text-white/60">0{i + 1}</b>
                    {s.en}
                    <span class="km text-xs" lang="km">{s.km}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <!-- An original picture: a phone with a play button and a download arrow. -->
        <div class="relative mx-auto hidden w-64 lg:block" aria-hidden="true">
          <div class="float">
            <svg viewBox="0 0 220 360" class="w-full drop-shadow-[0_30px_40px_rgba(0,0,0,0.45)]" role="img" aria-label="">
              <defs>
                <linearGradient id="screen" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#ff8a4c" />
                  <stop offset="0.55" stop-color="#e2552f" />
                  <stop offset="1" stop-color="#7a2a6b" />
                </linearGradient>
                <linearGradient id="arrow" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffd166" />
                  <stop offset="1" stop-color="#f4b33d" />
                </linearGradient>
              </defs>
              <rect x="10" y="6" width="200" height="348" rx="34" fill="#0f0d1c" />
              <rect x="20" y="16" width="180" height="328" rx="26" fill="url(#screen)" />
              <rect x="80" y="22" width="60" height="8" rx="4" fill="#0f0d1c" opacity="0.55" />
              <circle cx="110" cy="130" r="46" fill="#fff" opacity="0.18" />
              <path d="M98 106 L98 154 L138 130 Z" fill="#fff" />
              <rect x="40" y="206" width="140" height="10" rx="5" fill="#fff" opacity="0.35" />
              <rect x="40" y="226" width="96" height="10" rx="5" fill="#fff" opacity="0.25" />
              <circle cx="110" cy="296" r="30" fill="url(#arrow)" />
              <path d="M110 282 L110 304 M100 295 L110 306 L120 295" stroke="#1d1a2e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </div>
          <div class="absolute -top-2 -right-6 rotate-6 rounded-2xl bg-white px-3 py-2 text-sm font-bold text-ink shadow-xl float-slow">1080p ✨</div>
          <div class="absolute bottom-16 -left-10 -rotate-6 rounded-2xl bg-sun px-3 py-2 text-sm font-bold text-ink shadow-xl float">001 ✅</div>
        </div>
      </div>
    </section>

    <!-- THE CARD -->
    <section class="relative mx-auto -mt-24 max-w-3xl px-4 pb-14 sm:px-6">
      <!-- Shown only on the public website, where downloading cannot work. -->
      <section id="public-guide" class="hidden rounded-3xl border border-ink/10 bg-white p-6 shadow-2xl shadow-ink/15 sm:p-9">
        <h2 class="font-display text-3xl font-extrabold">
          Start here
          <span class="km text-lg" lang="km">ចាប់ផ្តើមនៅទីនេះ</span>
        </h2>
        <p class="mt-3 text-muted">
          Downloading works on your own computer, not on this public page.
          <span class="km" lang="km">ការទាញយកដំណើរការលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ មិនមែនលើទំព័រសាធារណៈនេះទេ។</span>
        </p>
        <ol class="mt-6 space-y-4">
          <li class="flex gap-4">
            <span class="step-chip">1</span>
            <p class="pt-1">
              Open the <b>tiktok-saver</b> folder on your computer, and double-click <b>start.bat</b>.
              <span class="km text-muted" lang="km">បើកថត tiktok-saver លើកុំព្យូទ័ររបស់អ្នក ហើយចុចពីរដងលើ start.bat។</span>
            </p>
          </li>
          <li class="flex gap-4">
            <span class="step-chip">2</span>
            <p class="pt-1">
              Your browser opens your own page. Paste the link there.
              <span class="km text-muted" lang="km">browser របស់អ្នកបើកទំព័រផ្ទាល់ខ្លួនរបស់អ្នក។ បិទភ្ជាប់តំណនៅទីនោះ។</span>
            </p>
          </li>
          <li class="flex gap-4">
            <span class="step-chip">3</span>
            <p class="pt-1">
              Press <b>Download 1 video</b>. The video is saved in <b>Downloads\TikTok Saver</b>.
              <span class="km text-muted" lang="km">ចុច Download 1 video។ វីដេអូត្រូវបានរក្សាទុកក្នុង Downloads\TikTok Saver។</span>
            </p>
          </li>
        </ol>
        <a href="http://localhost:4323/" class="btn-main mt-7 inline-block rounded-full px-7 py-3 font-semibold text-white">
          Open my page <span lang="km" class="font-khmer font-normal opacity-80">បើកទំព័ររបស់ខ្ញុំ</span>
        </a>
        <p class="mt-3 text-sm text-muted">
          This button works only after you double-click start.bat.
          <span class="km" lang="km">ប៊ូតុងនេះដំណើរការតែបន្ទាប់ពីអ្នកចុចពីរដងលើ start.bat ប៉ុណ្ណោះ។</span>
        </p>
      </section>

      <p id="banner" role="status" class="mb-4 hidden rounded-2xl border border-brand/30 bg-white p-4 shadow-lg"></p>

      <form id="save-form" class="rounded-3xl border border-ink/10 bg-white p-6 shadow-2xl shadow-ink/15 sm:p-9" novalidate>
        <!-- STEP 1 -->
        <div class="flex items-center gap-3">
          <span class="step-chip">1</span>
          <label for="link" class="font-display text-xl font-bold">
            Paste the TikTok link
            <span class="km text-base" lang="km">បិទភ្ជាប់តំណ TikTok</span>
          </label>
        </div>
        <input
          id="link"
          name="link"
          type="url"
          inputmode="url"
          autocomplete="off"
          placeholder="https://www.tiktok.com/..."
          class="mt-4 w-full rounded-2xl border-2 border-ink/15 bg-paper px-5 py-4 text-base outline-none transition focus:border-brand focus:bg-white focus:shadow-[0_0_0_4px_rgb(226_85_47/0.15)]"
        />

        <!-- STEP 2 -->
        <div class="mt-9 flex items-center gap-3">
          <span class="step-chip">2</span>
          <p class="font-display text-xl font-bold">
            Choose your options
            <span class="km text-base" lang="km">ជ្រើសរើសជម្រើសរបស់អ្នក</span>
          </p>
        </div>

        <div class="mt-4 rounded-2xl border border-ink/10 bg-paper/70 p-4 sm:p-5">
          <p class="font-display text-base font-bold">
            📁 Save to
            <span class="km text-sm" lang="km">រក្សាទុកទៅ</span>
          </p>
          <!-- The folder name has its own full-width row. The two buttons sit in a row below it. -->
          <p id="folder-path" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm break-words">…</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <button
              id="choose-folder"
              type="button"
              class="rounded-full border-2 border-ink/15 bg-white px-5 py-2 font-semibold transition hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-50"
            >
              Choose folder <span lang="km" class="font-khmer font-normal opacity-70">ជ្រើសរើសថត</span>
            </button>
            <button
              id="open-folder"
              type="button"
              class="rounded-full bg-ink px-5 py-2 font-semibold text-paper transition hover:bg-brand disabled:cursor-not-allowed disabled:opacity-50"
            >
              📂 Open folder <span lang="km" class="font-khmer font-normal opacity-80">បើកថតមើលវីដេអូ</span>
            </button>
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-ink/10 bg-paper/70 p-4 sm:p-5">
          <label for="quality" class="block font-display text-base font-bold">
            🎞️ Quality
            <span class="km text-sm" lang="km">គុណភាព</span>
          </label>
          <select
            id="quality"
            class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-base outline-none focus:border-brand"
          >
            <option value="best">Best available (recommended)</option>
            <option value="2160">4K (2160p) - TikTok has no 4K, you get its best</option>
            <option value="1440">1440p</option>
            <option value="1080">1080p</option>
            <option value="720">720p</option>
            <option value="480">480p</option>
            <option value="360">360p</option>
            <option value="240">240p</option>
            <option value="144">144p</option>
          </select>
          <p class="mt-2 text-sm text-muted">
            TikTok decides which qualities a video has. Most videos are 1080p or lower, and TikTok has no 4K. If the quality you choose is not there, you get the closest one. After the download, the page tells you the quality you really got.
            <span class="km" lang="km">TikTok កំណត់ថាវីដេអូមានគុណភាពអ្វីខ្លះ។ វីដេអូភាគច្រើនមាន 1080p ឬទាបជាងនេះ ហើយ TikTok គ្មាន 4K ទេ។ បើគុណភាពដែលអ្នកជ្រើសមិនមាន អ្នកនឹងទទួលបានគុណភាពជិតបំផុត។ បន្ទាប់ពីការទាញយក ទំព័រប្រាប់អ្នកពីគុណភាពដែលអ្នកទទួលបានពិតប្រាកដ។</span>
          </p>
        </div>

        <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-2xl border border-ink/10 bg-paper/70 p-4 sm:p-5">
          <input id="caption" type="checkbox" checked class="mt-1 size-5 shrink-0 accent-brand" />
          <span>
            <span class="font-display text-base font-bold">💬 Put the caption on the video</span>
            <span class="km font-display text-sm font-bold" lang="km">ដាក់ caption លើវីដេអូ</span>
            <span class="mt-1 block text-sm text-muted">
              The caption is written at the bottom of the picture. This takes extra time, and the picture is processed again.
              <span class="km" lang="km">caption ត្រូវបានសរសេរនៅខាងក្រោមរូបភាព។ វាចំណាយពេលបន្ថែម ហើយរូបភាពត្រូវបានដំណើរការម្តងទៀត។</span>
            </span>
          </span>
        </label>

        <!-- STEP 3 -->
        <div class="mt-9 flex items-center gap-3">
          <span class="step-chip">3</span>
          <p class="font-display text-xl font-bold">
            Download
            <span class="km text-base" lang="km">ទាញយក</span>
          </p>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <button
            type="button"
            data-mode="one"
            class="mode-button btn-main flex-1 rounded-full px-6 py-4 text-lg font-bold text-white"
          >
            ⬇️ Download 1 video <span lang="km" class="font-khmer text-base font-normal opacity-85">ទាញយក ១ វីដេអូ</span>
          </button>
          <button
            type="button"
            data-mode="all"
            class="mode-button flex-1 rounded-full border-2 border-ink/20 bg-white px-6 py-4 text-lg font-bold transition hover:-translate-y-0.5 hover:border-brand hover:text-brand disabled:cursor-not-allowed disabled:opacity-50"
          >
            📚 Download all videos <span lang="km" class="font-khmer text-base font-normal opacity-70">ទាញយកវីដេអូទាំងអស់</span>
          </button>
        </div>
        <button
          id="stop"
          type="button"
          disabled
          class="mt-3 w-full rounded-full bg-red-600 px-6 py-3 font-semibold text-white shadow-lg shadow-red-600/25 transition hover:bg-red-700 disabled:cursor-not-allowed disabled:bg-ink/10 disabled:text-ink/40 disabled:shadow-none"
        >
          ⏹ Stop download <span lang="km" class="font-khmer font-normal opacity-80">បញ្ឈប់ការទាញយក</span>
        </button>

        <ul class="mt-5 space-y-2 text-sm text-muted">
          <li>
            <b class="text-ink">1 video:</b> copy the link of the video.
            <span class="km" lang="km">១ វីដេអូ៖ ចម្លងតំណរបស់វីដេអូ។</span>
          </li>
          <li>
            <b class="text-ink">All videos:</b> copy the link of the profile (account) or of a video.
            <span class="km" lang="km">វីដេអូទាំងអស់៖ ចម្លងតំណរបស់ប្រូហ្វាល់ (គណនី) ឬតំណរបស់វីដេអូ។</span>
          </li>
        </ul>
        <p id="message" role="status" class="msg msg-info mt-5 hidden"></p>
      </form>

      <p class="mt-6 rounded-2xl bg-sun/15 px-4 py-3 text-sm text-ink/80">
        🙏 Only save your own videos, or videos where the owner says OK. This also applies to "all videos" of a profile.
        <span class="km" lang="km">រក្សាទុកតែវីដេអូរបស់អ្នកផ្ទាល់ ឬវីដេអូដែលម្ចាស់អនុញ្ញាត។ នេះក៏ត្រូវប្រើជាមួយ "វីដេអូទាំងអស់" របស់ប្រូហ្វាល់ដែរ។</span>
      </p>
    </section>

    <!-- FEATURES -->
    <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
      <h2 class="text-center font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
        Made to be simple
        <span class="km" lang="km">បង្កើតឡើងដើម្បីឱ្យសាមញ្ញ</span>
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          perks.map((p) => (
            <article class="lift rounded-3xl border border-ink/10 bg-white p-6">
              <span class="grid size-12 place-items-center rounded-2xl bg-sun/25 text-2xl" aria-hidden="true">{p.icon}</span>
              <h3 class="mt-4 font-display text-lg font-bold">
                {p.en}
                <span class="km" lang="km">{p.km}</span>
              </h3>
              <p class="mt-2 text-sm text-muted">
                {p.text}
                <span class="km" lang="km">{p.textKm}</span>
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#save-form')!;
  const input = document.querySelector<HTMLInputElement>('#link')!;
  const message = document.querySelector<HTMLElement>('#message')!;

  function show(en: string, km: string) {
    // The box color follows the kind of message: done (green), problem (red), or working (orange).
    const kind = en.startsWith('✅')
      ? 'msg-success'
      : /^(Could not|The helper|Lost contact|That is not|This is a profile|TikTok did not|You are on)/.test(en)
        ? 'msg-error'
        : /^(Stopped|A window opened)/.test(en)
          ? 'msg-info'
          : 'msg-working';
    message.className = `msg ${kind} mt-5`;
    message.innerHTML = '';
    message.append(en);
    const span = document.createElement('span');
    span.className = 'km';
    span.lang = 'km';
    span.textContent = km;
    message.append(span);
    message.classList.remove('hidden');
  }

  // Works out what kind of TikTok link this is: a 'video', a 'profile', or null.
  function linkKind(text: string): 'video' | 'profile' | null {
    let url: URL;
    try {
      url = new URL(text.trim());
    } catch {
      return null;
    }
    const host = url.hostname;
    if (host !== 'tiktok.com' && !host.endsWith('.tiktok.com')) return null;
    const path = url.pathname.replace(/\/+$/, '');
    if (/^\/@[^/]+$/.test(path)) return 'profile';
    // Video pages, and the short share links (vm.tiktok.com, vt.tiktok.com, tiktok.com/t/...).
    if (/^\/@[^/]+\/(video|photo)\/\d+/.test(path)) return 'video';
    if (host.startsWith('vm.') || host.startsWith('vt.') || path.startsWith('/t/')) return 'video';
    return null;
  }

  function choose(mode: string) {
    const kind = linkKind(input.value);
    if (!kind) {
      show('That is not a TikTok link. Please copy the link from TikTok and try again.', 'នេះមិនមែនជាតំណ TikTok ទេ។ សូមចម្លងតំណពី TikTok ហើយព្យាយាមម្តងទៀត។');
      return;
    }
    if (mode === 'one' && kind === 'profile') {
      show(
        'This is a profile link. To download 1 video, copy the link of that video. To download every video, use the other button.',
        'នេះជាតំណប្រូហ្វាល់។ ដើម្បីទាញយក ១ វីដេអូ សូមចម្លងតំណរបស់វីដេអូនោះ។ ដើម្បីទាញយកទាំងអស់ សូមប្រើប៊ូតុងមួយទៀត។',
      );
      return;
    }
    save(mode);
  }

  // Sends the link to the helper program on this computer, then checks on it until it is done.
  const HELPER = '/helper';
  let busy = false;
  let currentJob = '';
  const stopButton = document.querySelector<HTMLButtonElement>('#stop')!;

  // The Stop button: asks the helper to stop. The page then shows "Stopped" by itself.
  stopButton.addEventListener('click', () => {
    if (!currentJob) return;
    stopButton.disabled = true;
    fetch(`${HELPER}/stop`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
      body: JSON.stringify({ id: currentJob }),
    }).catch(() => {
      stopButton.disabled = false;
    });
  });

  async function save(mode: string) {
    if (busy) return;
    busy = true;
    show('Working… please wait. Big profiles can take a long time.', 'កំពុងដំណើរការ… សូមរង់ចាំ។ ប្រូហ្វាល់ធំអាចចំណាយពេលយូរ។');
    try {
      let start: Response;
      try {
        start = await fetch(`${HELPER}/download`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
          body: JSON.stringify({ link: input.value.trim(), mode, quality: document.querySelector<HTMLSelectElement>('#quality')!.value, folder, caption: document.querySelector<HTMLInputElement>('#caption')!.checked }),
        });
      } catch {
        // The browser could not reach the helper at all.
        show(
          'The helper program is not running. Open a terminal in your project and run: npm run helper',
          'កម្មវិធីជំនួយមិនដំណើរការទេ។ បើក terminal ក្នុងគម្រោងរបស់អ្នក ហើយរត់៖ npm run helper',
        );
        return;
      }
      if (start.status === 404 || start.status === 405) {
        // Only the copy of the site running on your own computer has the helper.
        show(
          'You are on the public website. Downloading only works on your own computer. Double-click start.bat in your tiktok-saver folder.',
          'អ្នកកំពុងនៅលើគេហទំព័រសាធារណៈ។ ការទាញយកដំណើរការតែលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ប៉ុណ្ណោះ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក។',
        );
        return;
      }
      if (!start.ok) {
        show(`The helper did not accept this request (code ${start.status}). Please copy the link again from TikTok.`, `កម្មវិធីជំនួយមិនទទួលសំណើនេះទេ (លេខកូដ ${start.status})។ សូមចម្លងតំណម្តងទៀតពី TikTok។`);
        return;
      }
      const { id } = await start.json();
      currentJob = id;
      stopButton.disabled = false;
      while (true) {
        await new Promise((resolve) => setTimeout(resolve, 1500));
        const info = await (await fetch(`${HELPER}/status/${id}`)).json();
        if (info.status === 'running' && info.stage === 'finding') {
          show('Finding the account of this video…', 'កំពុងរកគណនីរបស់វីដេអូនេះ…');
        } else if (info.status === 'running' && info.stage === 'captioning') {
          show(`Writing the caption on the video… ${info.captioned} of ${info.count}`, `កំពុងសរសេរ caption លើវីដេអូ… ${info.captioned} ក្នុងចំណោម ${info.count}`);
        } else if (info.status === 'running') {
          show(`Saved ${info.count} video(s) so far…`, `បានរក្សាទុក ${info.count} វីដេអូរហូតមកដល់ឥឡូវ…`);
        } else if (info.status === 'done') {
          const quality = info.heights?.length ? ` (${info.heights.map((h: string) => `${h}p`).join(', ')})` : '';
          show(`✅ Finish download. Saved ${info.count} video(s)${quality} in: ${info.folder}`, `✅ ការទាញយកបានបញ្ចប់។ បានរក្សាទុក ${info.count} វីដេអូ${quality} ក្នុងថត៖ ${info.folder}`);
          if (info.notes?.length) message.append(` ⚠ ${info.notes.join(' ')}`);
          break;
        } else if (info.status === 'stopped') {
          show(
            `Stopped. ${info.count} video(s) were already saved and are still in your folder.`,
            `បានបញ្ឈប់។ មាន ${info.count} វីដេអូត្រូវបានរក្សាទុករួចហើយ ហើយនៅក្នុងថតរបស់អ្នកនៅឡើយ។`,
          );
          break;
        } else {
          show(`Could not save the video. ${info.message}`, 'មិនអាចរក្សាទុកវីដេអូបានទេ។ TikTok អាចរារាំង ឬវីដេអូជាឯកជន។');
          break;
        }
      }
    } catch {
      show('Lost contact with the helper while saving. Check that it is still running, then try again.', 'បាត់ទំនាក់ទំនងជាមួយកម្មវិធីជំនួយពេលកំពុងរក្សាទុក។ សូមពិនិត្យថាវានៅដំណើរការ ហើយព្យាយាមម្តងទៀត។');
    } finally {
      busy = false;
      currentJob = '';
      stopButton.disabled = true;
    }
  }

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.mode-button')];
  const banner = document.querySelector<HTMLElement>('#banner')!;
  const openFolder = document.querySelector<HTMLButtonElement>('#open-folder')!;

  for (const button of buttons) {
    button.addEventListener('click', () => choose(button.dataset.mode ?? 'one'));
  }

  // The folder where videos are saved. The choice is remembered in this browser.
  const folderPath = document.querySelector<HTMLElement>('#folder-path')!;
  const chooseButton = document.querySelector<HTMLButtonElement>('#choose-folder')!;
  let folder = '';
  try {
    folder = localStorage.getItem('saveFolder') ?? '';
  } catch {
    folder = '';
  }
  if (folder) folderPath.textContent = folder;

  function setFolder(path: string) {
    folder = path;
    folderPath.textContent = path;
    try {
      localStorage.setItem('saveFolder', path);
    } catch {
      // The browser will not remember it. That is fine.
    }
  }

  openFolder.addEventListener('click', () => {
    fetch(`${HELPER}/open-folder`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
      body: JSON.stringify({ folder }),
    }).catch(() => {});
  });

  chooseButton.addEventListener('click', async () => {
    chooseButton.disabled = true;
    show('A window opened to choose a folder. It may be behind this page. Look at your taskbar.', 'បង្អួចមួយបានបើកដើម្បីជ្រើសរើសថត។ វាអាចនៅពីក្រោយទំព័រនេះ។ សូមមើលរបារកិច្ចការរបស់អ្នក។');
    try {
      const reply = await fetch(`${HELPER}/choose-folder`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-TikTok-Saver': '1' },
        body: JSON.stringify({ folder }),
      });
      const picked = (await reply.json()).folder;
      if (picked) setFolder(picked);
      message.classList.add('hidden');
    } catch {
      show('Could not open the folder window. Check that the helper is running.', 'មិនអាចបើកបង្អួចថតបានទេ។ សូមពិនិត្យថាកម្មវិធីជំនួយកំពុងដំណើរការ។');
    } finally {
      chooseButton.disabled = false;
    }
  });

  // Checks that the helper is ready. If not, say what to do and switch the buttons off.
  async function checkHelper() {
    let ready = false;
    try {
      const reply = await fetch(`${HELPER}/ping`);
      const info = await reply.json();
      ready = reply.ok && info.ok === true;
      // First time: show the helper's own default folder.
      if (ready && !folder) setFolder(info.folder);
    } catch {
      ready = false;
    }
    for (const button of buttons) {
      button.disabled = !ready;
      button.classList.toggle('opacity-50', !ready);
      button.classList.toggle('cursor-not-allowed', !ready);
    }
    chooseButton.disabled = !ready;
    openFolder.disabled = !ready;
    if (ready) {
      banner.classList.add('hidden');
      return;
    }
    banner.textContent = onThisComputer
      ? 'The helper is not running. Double-click start.bat in your tiktok-saver folder.'
      : 'This is the public website. Downloading only works on your own computer. Double-click start.bat in your tiktok-saver folder, then use the page that opens.';
    const km = document.createElement('span');
    km.className = 'km';
    km.lang = 'km';
    km.textContent = onThisComputer
      ? 'កម្មវិធីជំនួយមិនដំណើរការទេ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក។'
      : 'នេះជាគេហទំព័រសាធារណៈ។ ការទាញយកដំណើរការតែលើកុំព្យូទ័ររបស់អ្នកផ្ទាល់ប៉ុណ្ណោះ។ ចុចពីរដងលើ start.bat ក្នុងថត tiktok-saver របស់អ្នក ហើយប្រើទំព័រដែលបើក។';
    banner.append(km);
    banner.classList.remove('hidden');
  }
  const onThisComputer = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
  if (onThisComputer) {
    checkHelper();
    setInterval(() => {
      if (!busy) checkHelper();
    }, 4000);
  } else {
    // The public website: no download box, just the "Start here" steps.
    document.querySelector('#public-guide')!.classList.remove('hidden');
    form.classList.add('hidden');
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    choose('one');
  });
</script>
